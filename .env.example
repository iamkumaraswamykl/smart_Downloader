# Optional LLM classifier.
# When unset, the app uses the built-in local semantic classifier.
ORGANIZER_LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional defaults. They can also be set from the dashboard.
ORGANIZER_WATCH_PATH=
ORGANIZER_DESTINATION_ROOT=
ORGANIZER_DB_PATH=data/organizer.db
ORGANIZER_LOG_PATH=logs/organizer.log

# Tesseract must be installed separately for OCR.
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

